{
  "name": "bricked",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:controls": "node tests/controls-browser.mjs",
    "test:world": "node tests/infinite-world.mjs",
    "test:catalog": "node tests/catalog-browser.mjs all",
    "test:browser": "node tests/browser.mjs",
    "test:revision": "node tests/revision-browser.mjs all && node tests/revision-touch.mjs && node tests/revision-storage.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
